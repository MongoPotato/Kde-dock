{
  "pinned": [
    "org.kde.dolphin",
    "org.kde.konsole",
    "org.mozilla.firefox",
    "org.kde.kate"
  ],

  "position":    "bottom",
  "iconSize":    52,
  "padding":     8,
  "spacing":     6,
  "screenIndex": -1,

  "background": {
    "color":   "#1a1a2e",
    "opacity": 0.85,
    "radius":  14
  },

  "iconBackground": {
    "shape":       "none",
    "color":       "#ffffff",
    "opacity":     0.12,
    "padding":     6,
    "radius":      10,
    "borderColor": "#ffffff",
    "borderWidth": 0
  },

  "hover": {
    "liftPx":      6,
    "scaleBoost":  1.05,
    "glowOpacity": 0.35,
    "glowColor":   "auto"
  },

  "scroll": {
    "stepPx":  4,
    "minSize": 24,
    "maxSize": 128
  },

  "autohide":      false,
  "magnify":       true,
  "magnifyScale":  1.5,
  "magnifyRadius": 120,

  "runningIndicator": {
    "visible": true,
    "color":   "#ffffff",
    "size":    4
  }
}
